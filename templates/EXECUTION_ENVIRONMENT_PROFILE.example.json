{
  "schema_version": "2.1",
  "architecture_version": "2.1",
  "project_code": "{{PROJECT_CODE}}",
  "project_name": "{{PROJECT_NAME}}",
  "project_alias": "{{PROJECT_ALIAS}}",
  "updated_at": "{{DATE}}",
  "global_architecture_repository": "thiagoba2004/governanca-geral-modelos-ia",
  "global_architecture_file": "ARQUITETURA_UNIVERSAL_AMBIENTES_EXECUCAO_PERSISTENCIA.md",
  "governance_identity": {
    "independent_of_platform": true,
    "chatgpt_project_is_governance_project": false
  },
  "project_domain": "{{PROJECT_DOMAIN}}",
  "context_policy": {
    "observed_chatgpt_project_memory": "{{CHATGPT_PROJECT_MEMORY_MODE}}",
    "context_mode_source": "{{CONTEXT_MODE_SOURCE}}",
    "global_default": null,
    "selection_rule": "PER_PROJECT_EXPLICIT_NO_GLOBAL_DEFAULT",
    "work_available_inside_observed_context": "{{WORK_AVAILABLE_IN_OBSERVED_CONTEXT}}",
    "memory_is_source_of_truth": false
  },
  "canonical_persistence": {
    "type": "GIT_REPOSITORY",
    "repository_full_name": "{{PROJECT_REF}}",
    "source_of_truth": true
  },
  "access_preferences": {
    "A1_ANDROID_MOBILE": "E1_CHAT",
    "A2_WEB": "E2_WORK_WHEN_COMPATIBLE",
    "A3_DESKTOP": "E3_CODEX_FOR_REPOSITORY_WORK"
  },
  "executor_defaults": {
    "dialogue_decision_bounded_task": "E1_CHAT",
    "substantial_research_audit_many_files": "E2_WORK",
    "code_tests_repository_engineering": "E3_CODEX"
  },
  "knowledge_sources": {
    "K1_PROJECT_ATTACHED_SOURCES": {
      "role": "CURATED_CORE_CONTEXT",
      "full_repository": false,
      "plus_file_limit": 25,
      "simultaneous_upload_limit": 10
    },
    "K2_CHATGPT_LIBRARY": {
      "role": "OPERATIONAL_DISCOVERY_MIRROR",
      "canonical": false
    },
    "K3_GIT_REPOSITORY": {
      "role": "VERSIONED_CANONICAL_STATE",
      "repository_full_name": "{{PROJECT_REF}}"
    },
    "K4_CONNECTED_CLOUD_SOURCE": {
      "role": "MULTIPLATFORM_EXTERNAL_SOURCE",
      "canonical_only_if_explicitly_designated": true
    },
    "K5_LOCAL_FILESYSTEM": {
      "role": "WORKING_COPY_CACHE",
      "sole_canonical": false
    },
    "K6_WEB_EXTERNAL": {
      "role": "EVIDENCE_DISCOVERY",
      "canonical": false
    }
  },
  "handoff": {
    "required_when_preferred_executor_does_not_inherit_context": true,
    "minimum_context": [
      "project",
      "strategy",
      "phase",
      "objective",
      "decisions",
      "required_sources",
      "sensitivity",
      "canonical_destination",
      "completion_gate"
    ],
    "validate_before_canonical_persistence": true,
    "project_only_to_work": "CONDITIONAL_IF_CONTEXT_IS_C3"
  },
  "fallback": {
    "preserve_project_strategy_phase_identity": true,
    "use_nearest_available_executor": true,
    "persist_state_before_exit": true,
    "never_claim_unavailable_environment": true
  },
  "legacy_x_codes_read_only": true
}
